# Check system requirements
check_requirements() {
    log_info "Checking system requirements..."
    
    # Check kernel version
    if [[ $(echo "$KERNEL_VERSION < 5.10" | bc) -eq 1 ]]; then
        log_error "Kernel version $KERNEL_VERSION is too old. Need 5.10+"
        exit 1
    fi
    
    # Check CPU architecture
    ARCH=$(uname -m)
    if [[ "$ARCH" != "x86_64" && "$ARCH" != "aarch64" ]]; then
        log_error "Unsupported architecture: $ARCH"
        exit 1
    fi
    
    # Check memory
    MEMORY_KB=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    MEMORY_GB=$((MEMORY_KB / 1024 / 1024))
    if [ "$MEMORY_GB" -lt 64 ]; then
        log_warning "System has only ${MEMORY_GB}GB RAM (64GB recommended)"
    fi
    
    # Check hugepages
    HUGE_PAGES=$(cat /proc/sys/vm/nr_hugepages)
    if [ "$HUGE_PAGES" -lt 64 ]; then
        log_warning "Only ${HUGE_PAGES} hugepages configured (64 recommended)"
    fi
    
    # Check dependencies
    declare -a DEPENDENCIES=("gcc" "make" "cmake" "python3" "git" "wget")
    for dep in "${DEPENDENCIES[@]}"; do
        if ! command -v $dep &> /dev/null; then
            log_error "Missing dependency: $dep"
            exit 1
        fi
    done
    
    log_success "System requirements satisfied"
