#!/usr/bin/env python3
"""
Grover's Search Algorithm Example
Quantum search for marked items in unstructured database
"""

import numpy as np
from quenne_cpu import QCPU, QCPUContext
from quenne_cpu.quantum import QuantumCircuit
import time
import matplotlib.pyplot as plt

def create_oracle(num_qubits: int, marked_items: list) -> QuantumCircuit:
    """
    Create oracle that marks specific items.
    
    Args:
        num_qubits: Number of qubits (database size = 2^num_qubits)
        marked_items: List of indices to mark (0 to 2^num_qubits - 1)
    
    Returns:
        Quantum circuit implementing the oracle
    """
    oracle = QuantumCircuit(num_qubits + 1)  # +1 for ancilla
    
    # Mark each item with multi-controlled Z gate
    for item in marked_items:
        # Convert item to binary control conditions
        binary = format(item, f'0{num_qubits}b')
        
        # Apply X gates to qubits where binary is 0
        controls = []
        for i, bit in enumerate(binary):
            if bit == '0':
                oracle.x(i)
            else:
                controls.append(i)
        
        # Apply multi-controlled Z to ancilla
        oracle.mcz(controls, num_qubits)
        
        # Undo X gates
        for i, bit in enumerate(binary):
            if bit == '0':
                oracle.x(i)
    
    return oracle

def grover_search(num_items: int, marked_items: list, shots: int = 1000):
    """
    Perform Grover's search algorithm.
    
    Args:
        num_items: Size of database (must be power of 2)
        marked_items: List of marked items to find
        shots: Number of measurement shots
    
    Returns:
        Dictionary with search results
    """
    # Calculate number of qubits needed
    num_qubits = int(np.ceil(np.log2(num_items)))
    
    # Initialize QCPU
    ctx = QCPU(QCPUContext(
        quantum_qubits=num_qubits,
        classical_cores=1,
        memory='2GB'
    ))
    
    # Create oracle
    oracle = create_oracle(num_qubits, marked_items)
    
    # Create diffusion operator
    diffusion = QuantumCircuit(num_qubits)
    diffusion.h(range(num_qubits))
    diffusion.x(range(num_qubits))
    diffusion.h(num_qubits - 1)
    diffusion.mct(list(range(num_qubits - 1)), num_qubits - 1)
    diffusion.h(num_qubits - 1)
    diffusion.x(range(num_qubits))
    diffusion.h(range(num_qubits))
    
    # Optimal number of iterations
    optimal_iterations = int(np.pi/4 * np.sqrt(num_items / len(marked_items)))
    
    print(f"Database size: {num_items}")
    print(f"Marked items: {marked_items}")
    print(f"Qubits needed: {num_qubits}")
    print(f"Optimal iterations: {optimal_iterations}")
    
    # Initialize quantum register
    qreg = ctx.quantum.allocate_qubits(num_qubits)
    
    # Apply Hadamard to create superposition
    qreg.h(range(num_qubits))
    
    # Grover iterations
    start_time = time.time()
    
    for iteration in range(optimal_iterations):
        # Apply oracle
        qreg.append_circuit(oracle)
        
        # Apply diffusion operator
        qreg.append_circuit(diffusion)
        
        # Optional: Print progress
        if (iteration + 1) % max(1, optimal_iterations // 10) == 0:
            print(f"Iteration {iteration + 1}/{optimal_iterations}")
    
    # Measure results
    measurement = qreg.measure(shots=shots)
    
    execution_time = time.time() - start_time
    
    # Analyze results
    results = {}
    for state, count in measurement.items():
        item = int(state, 2)
        if item < num_items:
            results[item] = count
    
    # Sort by probability
    sorted_results = sorted(results.items(), key=lambda x: x[1], reverse=True)
    
    return {
        'execution_time': execution_time,
        'iterations': optimal_iterations,
        'measurements': results,
        'top_results': sorted_results[:10],
        'success_rate': sum(count for item, count in sorted_results[:len(marked_items)] 
                          if item in marked_items) / shots,
        'quantum_volume': 2 ** num_qubits,
    }

def benchmark_grover():
    """Benchmark Grover's algorithm for different database sizes."""
    sizes = [16, 64, 256, 1024, 4096]
    results = []
    
    for size in sizes:
        print(f"\n{'='*60}")
        print(f"Benchmarking Grover for database size {size}")
        print(f"{'='*60}")
        
        # Mark 1 item
        marked = [np.random.randint(0, size)]
        
        result = grover_search(size, marked, shots=1000)
        
        results.append({
            'size': size,
            'time': result['execution_time'],
            'success_rate': result['success_rate'],
            'quantum_volume': result['quantum_volume'],
        })
        
        print(f"Execution time: {result['execution_time']:.6f}s")
        print(f"Success rate: {result['success_rate']:.2%}")
        print(f"Top results: {result['top_results'][:3]}")
    
    return results

def plot_results(results):
    """Plot benchmarking results."""
    fig, axes = plt.subplots(2, 2, figsize=(12, 10))
    
    sizes = [r['size'] for r in results]
    times = [r['time'] for r in results]
    success = [r['success_rate'] for r in results]
    
    # Execution time
    axes[0, 0].plot(sizes, times, 'bo-', linewidth=2)
    axes[0, 0].set_xlabel('Database Size')
    axes[0, 0].set_ylabel('Execution Time (s)')
    axes[0, 0].set_title('Grover Search Execution Time')
    axes[0, 0].grid(True, alpha=0.3)
    axes[0, 0].set_xscale('log')
    axes[0, 0].set_yscale('log')
    
    # Success rate
    axes[0, 1].bar(range(len(sizes)), success)
    axes[0, 1].set_xlabel('Database Size')
    axes[0, 1].set_ylabel('Success Rate')
    axes[0, 1].set_title('Grover Search Success Rate')
    axes[0, 1].set_xticks(range(len(sizes)))
    axes[0, 1].set_xticklabels(sizes)
    axes[0, 1].grid(True, alpha=0.3)
    
    # Speedup compared to classical
    classical_times = [size / 1e9 for size in sizes]  # 1 ns per item check
    speedup = [classical_times[i] / times[i] for i in range(len(times))]
    
    axes[1, 0].plot(sizes, speedup, 'go-', linewidth=2)
    axes[1, 0].set_xlabel('Database Size')
    axes[1, 0].set_ylabel('Speedup Factor')
    axes[1, 0].set_title('Quantum Speedup vs Classical Search')
    axes[1, 0].grid(True, alpha=0.3)
    axes[1, 0].set_xscale('log')
    axes[1, 0].set_yscale('log')
    
    # Theoretical vs actual iterations
    theoretical_iters = [int(np.pi/4 * np.sqrt(size)) for size in sizes]
    axes[1, 1].plot(sizes, theoretical_iters, 'ro-', linewidth=2, label='Theoretical')
    axes[1, 1].set_xlabel('Database Size')
    axes[1, 1].set_ylabel('Optimal Iterations')
    axes[1, 1].set_title('Grover Algorithm Iterations')
    axes[1, 1].grid(True, alpha=0.3)
    axes[1, 1].legend()
    axes[1, 1].set_xscale('log')
    
    plt.tight_layout()
    plt.savefig('grover_benchmark.png', dpi=150, bbox_inches='tight')
    plt.show()

def main():
    """Main function to demonstrate Grover's search."""
    print("QUENNE QCPU - Grover's Search Algorithm Demo")
    print("=" * 60)
    
    # Simple example
    print("\n1. Simple Example (Database size: 8)")
    result = grover_search(8, [3, 6], shots=1000)
    
    print(f"Execution time: {result['execution_time']:.6f}s")
    print(f"Success rate: {result['success_rate']:.2%}")
