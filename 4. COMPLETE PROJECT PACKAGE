        """Test QFT circuit generation."""
        n_qubits = 4
        qft_circuit = self.ctx.quantum.create_qft_circuit(n_qubits)
        
        # QFT should have n*(n+1)/2 gates for n qubits
        expected_gates = n_qubits * (n_qubits + 1) // 2
