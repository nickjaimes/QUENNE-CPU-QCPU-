module quantum_gate_array #(
    parameter NUM_QUBITS = 256,
    parameter JOSEPHSON_ENERGY = 15.0, // GHz
    parameter CHARGING_ENERGY = 0.25,  // GHz
    parameter COUPLING_STRENGTH = 50.0 // MHz
