    output wire [31:0]       readout_data,
    output wire              readout_valid
);

    // Superconducting qubit parameters
    real EC = CHARGING_ENERGY;
    real EJ = JOSEPHSON_ENERGY;
    real ω01 = 8.0 * sqrt(EC * EJ) - EC; // Qubit frequency
    
    // Flux bias lines (for frequency tuning)
