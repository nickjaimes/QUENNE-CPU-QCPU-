from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.asymmetric import kyber, dilithium
from cryptography.hazmat.primitives.kdf.hkdf import HKDF
import numpy as np

class QUENNEPQC:
    """Post-Quantum Cryptography Implementation"""
    
    def __init__(self, security_level=3):  # 1=light, 2=medium, 3=high
        self.security_level = security_level
        self.setup_algorithms()
        
    def setup_algorithms(self):
        """Initialize PQC algorithms based on security level"""
        
        if self.security_level == 1:
            # Kyber-512
            self.kyber_params = kyber.Kyber512()
            # Dilithium2
            self.dilithium_params = dilithium.Dilithium2()
            
        elif self.security_level == 2:
            # Kyber-768
            self.kyber_params = kyber.Kyber768()
            # Dilithium3
            self.dilithium_params = dilithium.Dilithium3()
            
        else:  # security_level == 3
            # Kyber-1024
            self.kyber_params = kyber.Kyber1024()
            # Dilithium5
            self.dilithium_params = dilithium.Dilithium5()
        
        # Falcon for signatures
        self.falcon_params = {
            1: 512,   # Falcon-512
            2: 768,   # Falcon-768
            3: 1024   # Falcon-1024
        }[self.security_level]
        
    def kyber_key_exchange(self):
        """Kyber Key Encapsulation Mechanism"""
        
        # Generate key pair
        private_key = self.kyber_params.generate_private_key()
        public_key = private_key.public_key()
        
        # Encapsulation
        ciphertext, shared_secret = public_key.encapsulate()
        
        # Decapsulation
        received_secret = private_key.decapsulate(ciphertext)
        
        assert shared_secret == received_secret
        return shared_secret
    
    def dilithium_signature(self, message):
        """Dilithium Digital Signature"""
        
        # Generate key pair
        private_key = self.dilithium_params.generate_private_key()
        public_key = private_key.public_key()
        
        # Sign message
        signature = private_key.sign(message)
        
        # Verify signature
        public_key.verify(signature, message)
        
        return signature, public_key
    
    def quantum_safe_hybrid(self, classical_algo='RSA', pqc_algo='Kyber'):
        """Hybrid classical-PQC cryptography"""
        
        def hybrid_encrypt(plaintext, recipient_public_key):
            # Generate ephemeral key pair
            ephemeral_private = self.kyber_params.generate_private_key()
            ephemeral_public = ephemeral_private.public_key()
            
            # Derive two shared secrets
            # 1. PQC shared secret
            pqc_ciphertext, pqc_secret = ephemeral_public.encapsulate()
            
            # 2. Classical shared secret (for backward compatibility)
            if classical_algo == 'RSA':
                classical_ciphertext, classical_secret = self.rsa_encrypt(
                    ephemeral_public, recipient_public_key
                )
            elif classical_algo == 'ECDH':
                classical_ciphertext, classical_secret = self.ecdh_key_exchange(
                    ephemeral_private, recipient_public_key
                )
            
            # Combine secrets using KDF
            combined_secret = HKDF(
                algorithm=hashes.SHA3_512(),
                length=64,
                salt=None,
                info=b'hybrid-pqc'
            ).derive(pqc_secret + classical_secret)
            
            # Use first 32 bytes for AES key, next 32 for HMAC key
            aes_key = combined_secret[:32]
            hmac_key = combined_secret[32:]
            
            # Encrypt data
            ciphertext = self.aes_gcm_encrypt(plaintext, aes_key)
            
            # Create HMAC
            hmac = self.calculate_hmac(ciphertext, hmac_key)
            
            # Package everything
            return {
                'pqc_ciphertext': pqc_ciphertext,
                'classical_ciphertext': classical_ciphertext,
                'ciphertext': ciphertext,
                'hmac': hmac,
                'ephemeral_public': ephemeral_public
            }
        
        return hybrid_encrypt
    
    def lattice_based_encryption(self, message, params):
        """Custom lattice-based encryption for quantum resistance"""
        
        # Ring-LWE parameters
        n = params['n']  # polynomial degree
        q = params['q']  # modulus
        sigma = params['sigma']  # error distribution parameter
        
        # Generate key pair
        # Secret key: small polynomial s
        s = self.sample_polynomial(n, sigma)
        
        # Public key: (a, b = a*s + e)
        a = self.sample_uniform_polynomial(n, q)
        e = self.sample_polynomial(n, sigma)
        b = self.poly_add(self.poly_mul(a, s, q), e, q)
        
        # Encryption
        # Choose small polynomials r, e1, e2
        r = self.sample_polynomial(n, sigma)
        e1 = self.sample_polynomial(n, sigma)
        e2 = self.sample_polynomial(n, sigma)
        
        # Ciphertext: (c1 = a*r + e1, c2 = b*r + e2 + m*q/2)
        c1 = self.poly_add(self.poly_mul(a, r, q), e1, q)
        c2 = self.poly_add(
            self.poly_add(self.poly_mul(b, r, q), e2, q),
            self.encode_message(message, q),
            q
        )
        
        return (c1, c2), (s, a, b)
