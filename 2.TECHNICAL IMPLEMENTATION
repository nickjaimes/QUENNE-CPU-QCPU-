        # Verify error rates meet spec
        self.assertLess(error_rate, 1e-6,  # Should be < 1 ppm
                       f"Error rate too high: {error_rate:.2e}")
        
        # Verify error correction effectiveness
        quantum_error_rate = error_counts['quantum'] / total_operations
        self.assertLess(quantum_error_rate, 1e-7,  # Quantum should be < 0.1 ppm
                       f"Quantum error rate too high: {quantum_error_rate:.2e}")

