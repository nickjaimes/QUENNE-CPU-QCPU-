#!/bin/bash
# Complete QCPU System Integration Script

set -e

# Configuration
export QCPU_VERSION="1.0.0"
export PLATFORM="linux"
export ARCH="x86_64"
export INSTALL_PREFIX="/opt/quenne"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Logging
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check prerequisites
check_prerequisites() {
    log_info "Checking prerequisites..."
    
    # Check kernel version
    KERNEL_VERSION=$(uname -r | cut -d. -f1-2)
    if [[ $(echo "$KERNEL_VERSION < 5.10" | bc) -eq 1 ]]; then
        log_error "Kernel version $KERNEL_VERSION is too old. Need 5.10+"
        exit 1
    fi
    
    # Check dependencies
    declare -a DEPENDENCIES=("gcc" "make" "cmake" "python3" "git" "wget")
    for dep in "${DEPENDENCIES[@]}"; do
        if ! command -v $dep &> /dev/null; then
            log_error "Missing dependency: $dep"
            exit 1
        fi
    done
    
    # Check hardware
    if [[ ! -f "/sys/class/qcpu/qcpu0/version" ]]; then
        log_error "QCPU hardware not detected"
        exit 1
    fi
    
    log_info "All prerequisites satisfied"
}

# Build QCPU kernel module
build_kernel_module() {
    log_info "Building QCPU kernel module..."
    
    cd "$INSTALL_PREFIX/src/kernel"
    
    make clean
    make -j$(nproc)
    
    if [[ $? -ne 0 ]]; then
        log_error "Failed to build kernel module"
        exit 1
    fi
    
    # Install module
    sudo make modules_install
    sudo depmod -a
    
    log_info "Kernel module built successfully"
}

# Build QCPU runtime
build_runtime() {
    log_info "Building QCPU runtime..."
    
    cd "$INSTALL_PREFIX/src/runtime"
    
    mkdir -p build
    cd build
    
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DCMAKE_INSTALL_PREFIX="$INSTALL_PREFIX" \
             -DQCPU_QUANTUM_QUBITS=4096 \
             -DQCPU_NEURO_NEURONS=65536 \
             -DQCPU_CLASSICAL_CORES=32 \
             -DQCPU_MEMORY_GB=512
    
    make -j$(nproc)
    
    if [[ $? -ne 0 ]]; then
        log_error "Failed to build runtime"
        exit 1
    fi
    
    sudo make install
    
    log_info "Runtime built successfully"
}

# Build QCPU SDK
build_sdk() {
    log_info "Building QCPU SDK..."
    
    cd "$INSTALL_PREFIX/src/sdk"
    
    # Build Python bindings
    cd python
    pip3 install -e . --user
    
    if [[ $? -ne 0 ]]; then
        log_error "Failed to build Python SDK"
        exit 1
    fi
    
    # Build C++ SDK
    cd ../cpp
    mkdir -p build
    cd build
    
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DCMAKE_INSTALL_PREFIX="$INSTALL_PREFIX"
    
    make -j$(nproc)
    sudo make install
    
    log_info "SDK built successfully"
}

# Configure system
configure_system() {
    log_info "Configuring system..."
    
    # Load kernel module
    sudo modprobe qcpu
    
    # Create device nodes
    sudo mknod /dev/qcpu0 c 250 0
    sudo chmod 666 /dev/qcpu0
    
    # Setup hugepages
    echo 65536 > /proc/sys/vm/nr_hugepages
    
    # Setup cgroups
    sudo cgcreate -g memory,cpu:qcpu
    sudo cgset -r memory.limit_in_bytes=512G qcpu
    sudo cgset -r cpu.shares=1024 qcpu
    
    # Setup systemd service
    cat > /tmp/qcpu.service << EOF
[Unit]
Description=QUENNE QCPU Runtime
After=network.target

[Service]
Type=simple
ExecStart=$INSTALL_PREFIX/bin/qcpu-runtime
Restart=always
RestartSec=5
User=qcpu
Group=qcpu
LimitMEMLOCK=infinity
LimitSTACK=infinity
LimitCORE=infinity
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
EOF
    
    sudo cp /tmp/qcpu.service /etc/systemd/system/
    sudo systemctl daemon-reload
    sudo systemctl enable qcpu.service
    
    log_info "System configured successfully"
}

# Run validation tests
run_validation() {
    log_info "Running validation tests..."
    
    cd "$INSTALL_PREFIX/tests"
    
    # Run hardware tests
    sudo python3 hardware_validation.py
    
    if [[ $? -ne 0 ]]; then
        log_error "Hardware validation failed"
        exit 1
    fi
    
    # Run software tests
    python3 software_validation.py
    
    if [[ $? -ne 0 ]]; then
        log_error "Software validation failed"
        exit 1
    fi
    
    # Run performance tests
    python3 performance_validation.py
    
    if [[ $? -ne 0 ]]; then
        log_error "Performance validation failed"
        exit 1
    fi
    
    log_info "All validation tests passed"
}

# Setup monitoring
setup_monitoring() {
    log_info "Setting up monitoring..."
    
    # Install Prometheus
    if [[ ! -d "/opt/prometheus" ]]; then
        wget https://github.com/prometheus/prometheus/releases/download/v2.45.0/prometheus-2.45.0.linux-amd64.tar.gz
        tar xvf prometheus-2.45.0.linux-amd64.tar.gz
        sudo mv prometheus-2.45.0.linux-amd64 /opt/prometheus
    fi
    
    # Configure Prometheus
    cat > /tmp/prometheus.yml << EOF
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'qcpu'
    static_configs:
      - targets: ['localhost:8000']
    metrics_path: '/metrics'
    
  - job_name: 'node'
    static_configs:
      - targets: ['localhost:9100']
EOF
    
    sudo cp /tmp/prometheus.yml /opt/prometheus/
    
    # Install Grafana
    if ! dpkg -l | grep -q grafana; then
        sudo apt-get install -y grafana
    fi
    
    # Import QCPU dashboard
    sudo cp "$INSTALL_PREFIX/monitoring/grafana-dashboard.json" /var/lib/grafana/dashboards/
    
    # Start services
    sudo systemctl start prometheus
    sudo systemctl enable prometheus
    sudo systemctl start grafana-server
    sudo systemctl enable grafana-server
    
    log_info "Monitoring setup complete"
}

# Main installation
main() {
    log_info "Starting QCPU V1.0 System Integration"
    log_info "Version: $QCPU_VERSION"
    log_info "Platform: $PLATFORM"
    log_info "Architecture: $ARCH"
    
    # Check prerequisites
    check_prerequisites
    
    # Create installation directory
    sudo mkdir -p "$INSTALL_PREFIX"
    sudo chown -R $(whoami):$(whoami) "$INSTALL_PREFIX"
    
    # Clone source code
    if [[ ! -d "$INSTALL_PREFIX/src" ]]; then
        log_info "Cloning source code..."
        git clone https://github.com/quenne/qcpu.git "$INSTALL_PREFIX/src"
    fi
    
    # Build components
    build_kernel_module
    build_runtime
    build_sdk
    
    # Configure system
    configure_system
    
    # Run validation
    run_validation
    
    # Setup monitoring
    setup_monitoring
    
    # Start QCPU runtime
    log_info "Starting QCPU runtime..."
    sudo systemctl start qcpu.service
    
    # Final checks
    sleep 5
    if systemctl is-active --quiet qcpu.service; then
        log_info "QCPU runtime started successfully"
    else
        log_error "Failed to start QCPU runtime"
        exit 1
    fi
    
    log_info "QCPU V1.0 System Integration Complete!"
    log_info "Access endpoints:"
    log_info "  Quantum API: http://localhost:5000"
    log_info "  Neuromorphic API: http://localhost:5001"
    log_info "  Classical API: http://localhost:5002"
    log_info "  Fusion API: http://localhost:5003"
    log_info "  Monitoring: http://localhost:3000 (Grafana)"
    log_info "  Metrics: http://localhost:8000 (Prometheus)"
}

# Run main function
main "$@"
