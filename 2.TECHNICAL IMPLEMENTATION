            for layer in range(p):
                # Cost Hamiltonian unitary
                circuit.append(
                    expm(-1j * gamma[layer] * cost_hamiltonian),
                    range(self.num_qubits)
                )
                
                # Mixer Hamiltonian unitary
                circuit.append(
                    expm(-1j * beta[layer] * mixer_hamiltonian),
                    range(self.num_qubits)
                )
            
            return circuit
        
